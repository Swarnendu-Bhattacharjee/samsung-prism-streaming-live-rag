FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/pyproject.toml backend/
WORKDIR /app/backend
RUN pip install --no-cache-dir fastapi uvicorn sentence-transformers rank-bm25 google-genai openai anthropic pydantic pydantic-settings torch

COPY backend/ /app/backend/

ENV PYTHONPATH=/app/backend
EXPOSE 8000

CMD ["python3", "-m", "src", "--host", "0.0.0.0", "--port", "8000"]
